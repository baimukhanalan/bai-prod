generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  approved
  blocked
}

enum TaskType {
  main
  medium
  small
}

enum ResultType {
  income
  client
  call
  review
}

enum OnboardingStep {
  name
  phone
  age
  location
  occupation
  income
  goal
  give
  seek
  completed
}

enum CourseAccess {
  free
  full
  vip
}

enum LessonKind {
  video
  audio
  text
}

enum ContentKind {
  live
  article
  podcast
  community
  roadmap
  event
}

enum MatchRequestStatus {
  pending
  accepted
  declined
}

enum BookingStatus {
  requested
  confirmed
  completed
  cancelled
}

enum BotNotificationType {
  introLesson
  matchRequest
  matchAccepted
  matchContact
  dailyPlan
  weeklyCurator
  weeklyMatch
  streakRisk
}

model User {
  id               String             @id @default(cuid())
  telegramId       BigInt             @unique @map("telegram_id")
  username         String?
  name             String?
  phone            String?
  age              Int?
  location         String?
  timeZone         String             @default("Asia/Almaty") @map("time_zone")
  occupation       String?
  income           String?
  goal             String?
  giveTags         String[]           @default([]) @map("give_tags")
  seekTags         String[]           @default([]) @map("seek_tags")
  isDiscoverable   Boolean            @default(true) @map("is_discoverable")
  xp               Int                @default(0)
  monthlyXp        Int                @default(0) @map("monthly_xp")
  streakDays       Int                @default(0) @map("streak_days")
  bestStreak       Int                @default(0) @map("best_streak")
  lastActiveDate   DateTime?          @map("last_active_date") @db.Date
  level            String             @default("Новичок")
  status           UserStatus         @default(pending)
  access           CourseAccess       @default(free)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  tasks            Task[]
  aiLogs           AiLog[]
  results          ResultJournal[]
  onboarding       OnboardingSession?
  lessonProgress   LessonProgress[]
  activityDays     ActivityDay[]
  sentMatches      MatchRequest[]     @relation("MatchSender")
  receivedMatches  MatchRequest[]     @relation("MatchReceiver")
  curatorBookings  CuratorBooking[]
  aiDailyUsage     AiDailyUsage[]
  xpEvents         XpEvent[]
  botNotifications BotNotification[]

  @@map("users")
}

model Task {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String
  type        TaskType
  date        DateTime  @db.Date
  isCompleted Boolean   @default(false) @map("is_completed")
  xpReward    Int       @map("xp_reward")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("tasks")
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String
  access      CourseAccess @default(free)
  sortOrder   Int          @default(0) @map("sort_order")
  isPublished Boolean      @default(false) @map("is_published")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  lessons     Lesson[]

  @@map("courses")
}

model Lesson {
  id              String           @id @default(cuid())
  courseId        String           @map("course_id")
  slug            String
  title           String
  description     String?
  kind            LessonKind
  durationMinutes Int              @default(0) @map("duration_minutes")
  contentUrl      String?          @map("content_url")
  body            String?
  sortOrder       Int              @default(0) @map("sort_order")
  xpReward        Int              @default(20) @map("xp_reward")
  isPublished     Boolean          @default(false) @map("is_published")
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model ActivityDay {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  score     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("activity_days")
}

model ContentItem {
  id          String      @id @default(cuid())
  kind        ContentKind
  title       String
  description String?
  url         String?
  startsAt    DateTime?   @map("starts_at")
  isPublished Boolean     @default(false) @map("is_published")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([kind, isPublished, sortOrder])
  @@map("content_items")
}

model MatchRequest {
  id         String             @id @default(cuid())
  senderId   String             @map("sender_id")
  receiverId String             @map("receiver_id")
  pairKey    String             @unique @map("pair_key")
  message    String?
  status     MatchRequestStatus @default(pending)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  sender     User               @relation("MatchSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User               @relation("MatchReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("match_requests")
}

model BotNotification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  type         BotNotificationType
  dedupeKey    String              @unique @map("dedupe_key")
  payload      Json                @default("{}")
  scheduledFor DateTime            @default(now()) @map("scheduled_for")
  claimedAt    DateTime?           @map("claimed_at")
  sentAt       DateTime?           @map("sent_at")
  attempts     Int                 @default(0)
  lastError    String?             @map("last_error")
  createdAt    DateTime            @default(now()) @map("created_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt, scheduledFor])
  @@index([userId, type, createdAt])
  @@map("bot_notifications")
}

model CuratorBooking {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  preferredAt DateTime?     @map("preferred_at")
  note        String?
  status      BookingStatus @default(requested)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("curator_bookings")
}

model AiLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_logs")
}

model AiDailyUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("ai_daily_usage")
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  sourceKey String   @map("source_key")
  delta     Int
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  @@map("xp_events")
}

model ResultJournal {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  type            ResultType
  value           Decimal    @default(1) @db.Decimal(14, 2)
  note            String?
  xpReward        Int        @default(0) @map("xp_reward")
  clientRequestId String?    @map("client_request_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@map("results_journal")
}

model OnboardingSession {
  userId    String         @id @map("user_id")
  step      OnboardingStep @default(name)
  data      Json           @default("{}")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_sessions")
}
