{
  "name": "bai-prod",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,bot -c cyan,green,yellow \"npm:dev -w @bai/web\" \"npm:dev -w @bai/api\" \"npm:dev -w @bai/bot\"",
    "dev:web": "npm run dev -w @bai/web",
    "dev:api": "npm run dev -w @bai/api",
    "dev:bot": "npm run dev -w @bai/bot",
    "build": "npm run db:generate && npm run build -w @bai/api && npm run build -w @bai/bot && npm run build -w @bai/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @bai/api && npm run test -w @bai/bot",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:web",
    "test:e2e:api": "node e2e/api-e2e.mjs",
    "test:e2e:web": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.17.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "prisma": "6.12.0"
  }
}
